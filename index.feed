3e\u003cspan class=\"n\"\u003eeIdx\u003c/span\u003e\u003cspan class=\"p\"\u003e);\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e    \u003c/span\u003e\u003cspan class=\"k\"\u003ereturn\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"n\"\u003eroot\u003c/span\u003e\u003cspan class=\"p\"\u003e;\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e\u003c/span\u003e\u003cspan class=\"p\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003ch4 id=\"7-根据有序链表构造平衡的二叉查找树-convert-sorted-list-to-binary-search-tree-medium\" class=\"headerLink\"\u003e\n    \u003ca href=\"#7-%e6%a0%b9%e6%8d%ae%e6%9c%89%e5%ba%8f%e9%93%be%e8%a1%a8%e6%9e%84%e9%80%a0%e5%b9%b3%e8%a1%a1%e7%9a%84%e4%ba%8c%e5%8f%89%e6%9f%a5%e6%89%be%e6%a0%91-convert-sorted-list-to-binary-search-tree-medium\" class=\"header-mark\"\u003e\u003c/a\u003e7. 根据有序链表构造平衡的二叉查找树 Convert Sorted List to Binary Search Tree (Medium)\u003c/h4\u003e\u003ch4 id=\"8-在二叉查找树中寻找两个节点使它们的和为一个给定值-two-sum-iv---input-is-a-bst-easy\" class=\"headerLink\"\u003e\n    \u003ca href=\"#8-%e5%9c%a8%e4%ba%8c%e5%8f%89%e6%9f%a5%e6%89%be%e6%a0%91%e4%b8%ad%e5%af%bb%e6%89%be%e4%b8%a4%e4%b8%aa%e8%8a%82%e7%82%b9%e4%bd%bf%e5%ae%83%e4%bb%ac%e7%9a%84%e5%92%8c%e4%b8%ba%e4%b8%80%e4%b8%aa%e7%bb%99%e5%ae%9a%e5%80%bc-two-sum-iv---input-is-a-bst-easy\" class=\"header-mark\"\u003e\u003c/a\u003e8. 在二叉查找树中寻找两个节点，使它们的和为一个给定值 Two Sum IV - Input is a BST (Easy)\u003c/h4\u003e\u003cdiv class=\"code-block highlight is-closed show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    \n    tw-flex \n    tw-flex-row\n    tw-flex-1 \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e   