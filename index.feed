 \n      \u003cbutton \n        class=\"\n          copy-code-button\n          tw-select-none\n          tw-mx-2 \n          tw-hidden\n          group-[.is-open]:tw-block\n          hover:tw-text-fgColor-link \n          print:!tw-hidden\"\n        title=\"Copy code\"\u003e\n          \u003cspan class=\"copy-icon tw-block\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M433.941 65.941l-51.882-51.882A48 48 0 0 0 348.118 0H176c-26.51 0-48 21.49-48 48v48H48c-26.51 0-48 21.49-48 48v320c0 26.51 21.49 48 48 48h224c26.51 0 48-21.49 48-48v-48h80c26.51 0 48-21.49 48-48V99.882a48 48 0 0 0-14.059-33.941zM266 464H54a6 6 0 0 1-6-6V150a6 6 0 0 1 6-6h74v224c0 26.51 21.49 48 48 48h96v42a6 6 0 0 1-6 6zm128-96H182a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h106v88c0 13.255 10.745 24 24 24h88v202a6 6 0 0 1-6 6zm6-256h-64V48h9.632c1.591 0 3.117.632 4.243 1.757l48.368 48.368a6 6 0 0 1 1.757 4.243V112z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"check-icon tw-hidden\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw-select-none \n          tw-mx-2 \n          tw-block \n          group-[.is-open]:tw-hidden \n          print:!tw-hidden\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-2\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nt\"\u003eserver\u003c/span\u003e\u003cspan class=\"p\"\u003e:\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e\t\u003c/span\u003e\u003cspan class=\"nt\"\u003eport\u003c/span\u003e\u003cspan class=\"p\"\u003e:\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"m\"\u003e82\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eSpringBoot 配置文件加载顺序\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eapplication.\u003cstrong\u003eproperties\u003c/strong\u003e  \u0026gt;  application.\u003cstrong\u003eyml\u003c/strong\u003e  \u0026gt;  application.\u003cstrong\u003eyaml\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20230226_springboot-intro/image-20230629143350881.png' srcset=\"/20230226_springboot-intro/image-20230629143350881_hu_ba3d983055c60bef.webp 800w, /20230226_springboot-intro/image-20230629143350881_hu_ad26d01e9df39cc8.webp 1200w, /20230226_springboot-intro/image-20230629143350881_hu_a468191d8e8ad7de.webp 1600w\"  alt=\"image-20230629143350881\" height=\"840\" width=\"1652\"\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch4 id=\"yaml-语法规则\" class=\"headerLink\"\u003e\n    \u003ca href=\"#yaml-%e8%af%ad%e6%b3%95%e8%a7%84%e5%88%99\" class=\"header-mark\"\u003e\u003c/a\u003eyaml 语法规则\u003c/h4\u003e\u003cul\u003e\n\u003cli\u003e大小写敏感\u003c/li\u003e\n\u003cli\u003e属性层级关系使用多行描述，每行结尾使用冒号结束\u003c/li\u003e\n\u003cli\u003e使用缩进表示层级关系，同层级左则对齐，只充许使用空格（不充许使用Tab键）\u003c/li\u003e\n\u003cli\u003e属性值前面添加空格（属性名与属性值之间使用冒号+空格作为分隔）\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003e#\u003c/code\u003e 表示注释\u003c/li\u003e\n\u003cli\u003e数组数据在数据书写位置的下方使用减号作为数据开始符号，每行书写一个数据，减号与数据间空格分隔\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch4 id=\"yaml-数据读取\" class=\"headerLink\"\u003e\n    \u003ca href=\"#yaml-%e6%95%b0%e6%8d%ae%e8%af%bb%e5%8f%96\" class=\"header-mark\"\u003e\u003c/a\u003eyaml 数据读取\u003c/h4\u003e\u003cul\u003e\n\u003cli\u003e@Value 直接读取\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20230226_springboot-intro/image-20230629150618832.png' srcset=\"/20230226_springboot-intro/image-20230629150618832_hu_3ed9e25cfa1e5749.webp 800w, /20230226_springboot-intro/image-20230629150618832_hu_ec05c1cc113ae8fd.webp 1200w, /20230226_springboot-intro/image-20230629150618832_hu_16d1a79699e94d2b.webp 1600w\"  alt=\"image-20230629150618832\" height=\"754\" width=\"1410\"\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eEnvironment 封装后读取\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20230226_springboot-intro/image-20230629150842070.png' srcset=\"/20230226_springboot-intro/image-20230629150842070_hu_85fd2ebc1fa1b339.webp 800w, /20230226_springboot-intro/image-20230629150842070_hu_10ed9ffbbd9fca93.webp 1200w, /20230226_springboot-intro/image-20230629150842070_hu_a8ee481deeaec0ba.webp 1600w\"  alt=\"image-20230629150842070\" height=\"730\" width=\"1679\"\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003e实体类封装属性，封装后读取\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20230226_springboot-intro/image-20230629151213599.png' srcset=\"/20230226_springboot-intro/image-20230629151213599_hu_816a55a65975a10e.webp 800w, /20230226_springboot-intro/image-20230629151213599_hu_2efbace2d5ab9ab.webp 1200w, /20230226_springboot-intro/image-20230629151213599_hu_9a9e53253080f103.webp 1600w\"  alt=\"image-20230629151213599\" height=\"743\" width=\"1711\"\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch4 id=\"多环境启动\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%a4%9a%e7%8e%af%e5%a2%83%e5%90%af%e5%8a%a8\" class=\"header-mark\"\u003e\u003c/a\u003e多环境启动\u003c/h4\u003e\u003cul\u003e\n\u003cli\u003e使用 application.yml 文件多环境启动\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20230226_springboot-intro/image-20230629155835624.png' srcset=\"/20230226_springboot-intro/image-20230629155835624_hu_48d6ff9f76da45ee.webp 800w, /20230226_springboot-intro/image-20230629155835624_hu_165be802cfe3700a.webp 1200w, /20230226_springboot-intro/image-20230629155835624_hu_3a82cc9c0c239984.webp 1600w\"  alt=\"image-20230629155835624\" height=\"799\" width=\"1457\"\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e使用 properties 文件多环境启动\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20230226_springboot-intro/image-20230629160035584.png' srcset=\"/20230226_springboot-intro/image-20230629160035584_hu_d51517ed45864e79.webp 800w, /20230226_springboot-intro/image-20230629160035584_hu_68758353d9bdfdf4.webp 1200w, /20230226_springboot-intro/image-20230629160035584_hu_b3713539d0978ddc.webp 1600w\"  alt=\"image-20230629160035584\" height=\"620\" width=\"1553\"\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch3 id=\"多环境启动命令格式\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%a4%9a%e7%8e%af%e5%a2%83%e5%90%af%e5%8a%a8%e5%91%bd%e4%bb%a4%e6%a0%bc%e5%bc%8f\" class=\"header-mark\"\u003e\u003c/a\u003e多环境启动命令格式\u003c/h3\u003e\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003e带参数启动 SpringBoot\u003c/p\u003e\n\u003cp\u003e\u003ccode\u003ejava -jar springboot.jar --spring.profiles.active=test\u003c/code\u003e\u003c/p\u003e\n\u003cp\u003e\u003ccode\u003ejava -jar springboot.jar --server.port=88\u003c/code\u003e\u003c/p\u003e\n\u003cp\u003e\u003ccode\u003ejava -jar springboot.jar --spring.profiles.active=test --server.port=88\u003c/code\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch4 id=\"启动加载配置顺序\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%90%af%e5%8a%a8%e5%8a%a0%e8%bd%bd%e9%85%8d%e7%bd%ae%e9%a1%ba%e5%ba%8f\" class=\"header-mark\"\u003e\u003c/a\u003e启动加载配置顺序\u003c/h4\u003e\u003cp\u003e启动加载配置优先级，从低到高\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eDefault properties (specified by setting \u003ccode\u003eSpringApplication.setDefaultProperties\u003c/code\u003e).\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://docs.spring.io/spring-framework/docs/6.0.10/javadoc-api/org/springframework/context/annotation/PropertySource.html\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e\u003ccode\u003e@PropertySource\u003c/code\u003e\u003c/a\u003e annotations on your \u003ccode\u003e@Configuration\u003c/code\u003e classes. Please note that such property sources are not added to the \u003ccode\u003eEnvironment\u003c/code\u003e until the application context is being refreshed. This is too late to configure certain properties such as \u003ccode\u003elogging.*\u003c/code\u003e and \u003ccode\u003espring.main.*\u003c/code\u003e which are read before refresh begins.\u003c/li\u003e\n\u003cli\u003eConfig data (such as \u003ccode\u003eapplication.properties\u003c/code\u003e files).\u003c/li\u003e\n\u003cli\u003eA \u003ccode\u003eRandomValuePropertySource\u003c/code\u003e that has properties only in \u003ccode\u003erandom.*\u003c/code\u003e.\u003c/li\u003e\n\u003cli\u003eOS environment variables.\u003c/li\u003e\n\u003cli\u003eJava System properties (\u003ccode\u003eSystem.getProperties()\u003c/code\u003e).\u003c/li\u003e\n\u003cli\u003eJNDI attributes from \u003ccode\u003ejava:comp/env\u003c/code\u003e.\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003eServletContext\u003c/code\u003e init parameters.\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003eServletConfig\u003c/code\u003e init parameters.\u003c/li\u003e\n\u003cli\u003eProperties from \u003ccode\u003eSPRING_APPLICATION_JSON\u003c/code\u003e (inline JSON embedded in an environment variable or system property).\u003c/li\u003e\n\u003cli\u003eCommand line arguments.\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003eproperties\u003c/code\u003e attribute on your tests. Available on \u003ca href=\"https://docs.spring.io/spring-boot/docs/3.1.1/api/org/springframework/boot/test/context/SpringBootTest.html\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e\u003ccode\u003e@SpringBootTest\u003c/code\u003e\u003c/a\u003e and the \u003ca href=\"https://docs.spring.io/spring-boot/docs/current/reference/html/features.html#features.testing.spring-boot-applications.autoconfigured-tests\" target=\"_blank\" rel=\"noopener noreferrer\"\u003etest annotations for testing a particular slice of your application\u003c/a\u003e.\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://docs.spring.io/spring-framework/docs/6.0.10/javadoc-api/org/springframework/test/context/DynamicPropertySource.html\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e\u003ccode\u003e@DynamicPropertySource\u003c/code\u003e\u003c/a\u003e annotations in your tests.\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://docs.spring.io/spring-framework/docs/6.0.10/javadoc-api/org/springframework/test/context/TestPropertySource.html\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e\u003ccode\u003e@TestPropertySource\u003c/code\u003e\u003c/a\u003e annotations on your tests.\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://docs.spring.io/spring-boot/docs/current/reference/html/using.html#using.devtools.globalsettings\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eDevtools global settings properties\u003c/a\u003e in the \u003ccode\u003e$HOME/.config/spring-boot\u003c/code\u003e directory when devtools is active.\u003c/li\u003e\n\u003c/ol\u003e\n\u003ch3 id=\"多环境开发控制\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%a4%9a%e7%8e%af%e5%a2%83%e5%bc%80%e5%8f%91%e6%8e%a7%e5%88%b6\" class=\"header-mark\"\u003e\u003c/a\u003e多环境开发控制\u003c/h3\u003e\u003cul\u003e\n\u003cli\u003eMaven 主导工程，生成 jar 包\u003c/li\u003e\n\u003cli\u003eSpringBoot 是在 Maven 打包过程中作为一个工具\u003c/li\u003e\n\u003cli\u003e版本控制 Maven 为主，SpringBoot 为辅助\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20230226_springboot-intro/image-20230629161656867.png' srcset=\"/20230226_springboot-intro/image-20230629161656867_hu_b66091a7d42760e8.webp 800w, /20230226_springboot-intro/image-20230629161656867_hu_9bfabfd9d13f7291.webp 1200w, /20230226_springboot-intro/image-20230629161656867_hu_b63f01fac4acf43f.webp 1600w\"  alt=\"image-20230629161656867\" height=\"771\" width=\"1612\"\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch4 id=\"maven-与-springboot-多环境兼容\" class=\"headerLink\"\u003e\n    \u003ca href=\"#maven-%e4%b8%8e-springboot-%e5%a4%9a%e7%8e%af%e5%a2%83%e5%85%bc%e5%ae%b9\" class=\"header-mark\"\u003e\u003c/a\u003eMaven 与 SpringBoot 多环境兼容\u003c/h4\u003e\u003col\u003e\n\u003cli\u003e\n\u003cp\u003eMaven 中设置多环境属性\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-closed show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    \n    tw-flex \n    tw-flex-row\n    tw-flex-1 \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        code-block-button\n        tw-mx-2 \n        tw-flex\n        tw-flex-row\n        tw-flex-1\"\n      aria-hidden=\"true\"\u003e\n          \u003cdiv class=\"group-[.is-open]:tw-rotate-90 tw-transition-[transform] tw-duration-500 tw-ease-in-out print:!tw-hidden tw-w-min tw-h-min tw-my-1 tw-mx-1\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u003c/div\u003e\n          \u003cp class=\"tw-select-none !tw-my-1\"\u003exml\u003c/p\u003e\n      \u003c/button\u003e\n\n   \u003cdiv class=\"tw-flex\"\u003e\n      \u003cbutton \n        class=\"\n          line-number-button\n          tw-mx-2 \n          tw-hidden \n          group-[.is-open]:tw-block \n          group-[.show-line-numbers]:tw-text-fgColor-link \n          print:!tw-hidden\" \n        title=\"Toggle line numbers\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M61.77 401l17.5-20.15a19.92 19.92 0 0 0 5.07-14.19v-3.31C84.34 356 80.5 352 73 352H16a8 8 0 0 0-8 8v16a8 8 0 0 0 8 8h22.83a157.41 157.41 0 0 0-11 12.31l-5.61 7c-4 5.07-5.25 10.13-2.8 14.88l1.05 1.93c3 5.76 6.29 7.88 12.25 7.88h4.73c10.33 0 15.94 2.44 15.94 9.09 0 4.72-4.2 8.22-14.36 8.22a41.54 41.54 0 0 1-15.47-3.12c-6.49-3.88-11.74-3.5-15.6 3.12l-5.59 9.31c-3.72 6.13-3.19 11.72 2.63 15.94 7.71 4.69 20.38 9.44 37 9.44 34.16 0 48.5-22.75 48.5-44.12-.03-14.38-9.12-29.76-28.73-34.88zM496 224H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16v-32a16 16 0 0 0-16-16zm0-160H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16V80a16 16 0 0 0-16-16zm0 320H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16v-32a16 16 0 0 0-16-16zM16 160h64a8 8 0 0 0 8-8v-16a8 8 0 0 0-8-8H64V40a8 8 0 0 0-8-8H32a8 8 0 0 0-7.14 4.42l-8 16A8 8 0 0 0 24 64h8v64H16a8 8 0 0 0-8 8v16a8 8 0 0 0 8 8zm-3.91 160H80a8 8 0 0 0 8-8v-16a8 8 0 0 0-8-8H41.32c3.29-10.29 48.34-18.68 48.34-56.44 0-29.06-25-39.56-44.47-39.56-21.36 0-33.8 10-40.46 18.75-4.37 5.59-3 10.84 2.8 15.37l8.58 6.88c5.61 4.56 11 2.47 16.12-2.44a13.44 13.44 0 0 1 9.46-3.84c3.33 0 9.28 1.56 9.28 8.75C51 248.19 0 257.31 0 304.59v4C0 316 5.08 320 12.09 320z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n\n      \u003cbutton \n        class=\"\n          wrap-code-button\n          tw-select-none \n          tw-mx-2 \n          tw-hidden \n          group-[.is-open]:tw-block \n          group-[.is-wrap]:tw-text-fgColor-link \n          print:!tw-hidden\" \n        title=\"Toggle code wrap\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M16 132h416c8.837 0 16-7.163 16-16V76c0-8.837-7.163-16-16-16H16C7.163 60 0 67.163 0 76v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n      \n      \u003cbutton \n        class=\"\n          copy-code-button\n          tw-select-none\n          tw-mx-2 \n          tw-hidden\n          group-[.is-open]:tw-block\n          hover:tw-text-fgColor-link \n          print:!tw-hidden\"\n        title=\"Copy code\"\u003e\n          \u003cspan class=\"copy-icon tw-block\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M433.941 65.941l-51.882-51.882A48 48 0 0 0 348.118 0H176c-26.51 0-48 21.49-48 48v48H48c-26.51 0-48 21.49-48 48v320c0 26.51 21.49 48 48 48h224c26.51 0 48-21.49 48-48v-48h80c26.51 0 48-21.49 48-48V99.882a48 48 0 0 0-14.059-33.941zM266 464H54a6 6 0 0 1-6-6V150a6 6 0 0 1 6-6h74v224c0 26.51 21.49 48 48 48h96v42a6 6 0 0 1-6 6zm128-96H182a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h106v88c0 13.255 10.745 24 24 24h88v202a6 6 0 0 1-6 6zm6-256h-64V48h9.632c1.591 0 3.117.632 4.243 1.757l48.368 48.368a6 6 0 0 1 1.757 4.243V112z\"/\u003e\u003c/svg\