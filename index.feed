0-48 21.49-48 48v320c0 26.51 21.49 48 48 48h224c26.51 0 48-21.49 48-48v-48h80c26.51 0 48-21.49 48-48V99.882a48 48 0 0 0-14.059-33.941zM266 464H54a6 6 0 0 1-6-6V150a6 6 0 0 1 6-6h74v224c0 26.51 21.49 48 48 48h96v42a6 6 0 0 1-6 6zm128-96H182a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h106v88c0 13.255 10.745 24 24 24h88v202a6 6 0 0 1-6 6zm6-256h-64V48h9.632c1.591 0 3.117.632 4.243 1.757l48.368 48.368a6 6 0 0 1 1.757 4.243V112z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"check-icon tw-hidden\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw-select-none \n          tw-mx-2 \n          tw-block \n          group-[.is-open]:tw-hidden \n          print:!tw-hidden\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-7\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003egit branch \u003cspan class=\"o\"\u003e[\u003c/span\u003ename\u003cspan class=\"o\"\u003e]\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"c1\"\u003e#然后push\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003egit push -u origin \u003cspan class=\"o\"\u003e[\u003c/span\u003ename\u003cspan class=\"o\"\u003e]\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e",
        "language": "en"
    },
    {
        "title" : "Various data types in C",
        "date_published" : "2019-10-07T09:11:47+08:00",
        "date_modified" : "2019-10-07T09:11:47+08:00",
        "id" : "https://jerrysmd.github.io/20191007_u32/",
        "url" : "https://jerrysmd.github.io/20191007_u32/",
        "summary": "C/C++ provides various data types that can be used in your programs.In general, you\u0026rsquo;d commonly use: int for most variables and \u0026ldquo;countable\u0026rdquo; things (for loop counts, variables, events). char for characters and strings. float for general measurable things (seconds, distance, temperature). uint32 for bit manipulations, especially on 32-bit registers.\n",
        "content_html" : "\u003cp\u003eC/C++ provides various data types that can be used in your programs.In general, you\u0026rsquo;d commonly use: int for most variables and \u0026ldquo;countable\u0026rdquo; things (for loop counts, variables, events). char for characters and strings. float for general measurable things (seconds, distance, temperature). uint32 for bit manipulations, especially on 32-bit registers.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eint\u003c/strong\u003e for most variables and \u0026ldquo;countable\u0026rdquo; things (for loop counts, variables, events)\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003echar\u003c/strong\u003e for characters and strings\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003efloat\u003c/strong\u003e for general measurable things (seconds, distance, temperature)\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003euint32_t\u003c/strong\u003e for bit manipulations, especially on 32-bit registers\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3 id=\"integer-data-types\" class=\"headerLink\"\u003e\n    \u003ca href=\"#integer-data-types\" class=\"header-mark\"\u003e\u003c/a\u003eInteger Data Types\u003c/h3\u003e\n\u003cdiv class=\"table-wrapper\"\u003e\n  \u003ctable\u003e\n    \u003cthead\u003e\n        \u003ctr\u003e\n            \u003cth style=\"text-align: \"\u003eC type\u003c/th\u003e\n            \u003cth style=\"text-align: \"\u003ealias\u003c/th\u003e\n            \u003cth style=\"text-align: \"\u003eBits\u003c/th\u003e\n            \u003cth style=\"text-align: \"\u003eSign\u003c/th\u003e\n            \u003cth style=\"text-align: \"\u003eRange\u003c/th\u003e\n        \u003c/tr\u003e\n    \u003c/thead\u003e\n    \u003ctbody\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: \"\u003echar\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003eint8\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e8\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003eSigned\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e-128 .. 127\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: \"\u003eunsigned char\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003euint8\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e8\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003eUnsigned\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e0 .. 255\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: \"\u003eshort\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003eint16\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e16\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003eSigned\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e-32,768 .. 32,767\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: \"\u003eunsigned short\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003euint16\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e16\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003eUnsigned\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e0 .. 65,535\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: \"\u003eint\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003eint32\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e32\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003eSigned\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e-2,147,483,648 .. 2,147,483,647\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: \"\u003eunsigned int\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003euint32\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e32\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003eUnsigned\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e0 .. 4,294,967,295\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: \"\u003elong long\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003eint64\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e64\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003eSigned\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e-9,223,372,036,854,775,808 .. 9,223,372,036,854,775,807\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: \"\u003eunsigned long long\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003euint64\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e64\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003eUnsigned\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e0 .. 18,446,744,073,709,551,615\u003c/td\u003e\n        \u003c/tr\u003e\n    \u003c/tbody\u003e\n  \u003c/table\u003e\n\u003c/div\u003e\n\u003ch3 id=\"floating-point-data-types\" class=\"headerLink\"\u003e\n    \u003ca href=\"#floating-point-data-types\" class=\"header-mark\"\u003e\u003c/a\u003eFloating Point Data Types\u003c/h3\u003e\n\u003cdiv class=\"table-wrapper\"\u003e\n  \u003ctable\u003e\n    \u003cthead\u003e\n        \u003ctr\u003e\n            \u003cth style=\"text-align: \"\u003eC type\u003c/th\u003e\n            \u003cth style=\"text-align: \"\u003eIEE754 Name\u003c/th\u003e\n            \u003cth style=\"text-align: \"\u003eBits\u003c/th\u003e\n            \u003cth style=\"text-align: \"\u003eRange\u003c/th\u003e\n        \u003c/tr\u003e\n    \u003c/thead\u003e\n    \u003ctbody\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: \"\u003efloat\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003eSingle Precision\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e32\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e-3.4E38 .. 3.4E38\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: \"\u003edouble\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003eDouble Precision\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e64\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e-1.7E308 .. 1.7E308\u003c/td\u003e\n        \u003c/tr\u003e\n    \u003c/tbody\u003e\n  \u003c/table\u003e\n\u003c/div\u003e\n\u003ch3 id=\"print-format\" class=\"headerLink\"\u003e\n    \u003ca href=\"#print-format\" class=\"header-mark\"\u003e\u003c/a\u003ePrint format\u003c/h3\u003e\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    \n    tw-flex \n    tw-flex-row\n    tw-flex-1 \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        code-block-button\n        tw-mx-2 \n        tw-flex\n        tw-flex-row\n        tw-flex-1\"\n      aria-hidden=\"true\"\u003e\n          \u003cdiv class=\"group-[.is-open]:tw-rotate-90 tw-transition-[transform] tw-duration-500 tw-ease-in-out print:!tw-hidden tw-w-min tw-h-min tw-my-1 tw-mx-1\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u