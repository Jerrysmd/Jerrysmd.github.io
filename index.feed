03e\u003cspan class=\"kd\"\u003eprivate\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"n\"\u003eBookDao\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"n\"\u003ebookDao\u003c/span\u003e\u003cspan class=\"p\"\u003e;\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e    \u003c/span\u003e\u003cspan class=\"nd\"\u003e@Test\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e    \u003c/span\u003e\u003cspan class=\"kd\"\u003epublic\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"kt\"\u003evoid\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"nf\"\u003etestGetById\u003c/span\u003e\u003cspan class=\"p\"\u003e(){\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e        \u003c/span\u003e\u003cspan class=\"n\"\u003eBookbook\u003c/span\u003e\u003cspan class=\"o\"\u003e=\u003c/span\u003e\u003cspan class=\"n\"\u003ebookDao\u003c/span\u003e\u003cspan class=\"p\"\u003e.\u003c/span\u003e\u003cspan class=\"na\"\u003egetById\u003c/span\u003e\u003cspan class=\"p\"\u003e(\u003c/span\u003e\u003cspan class=\"n\"\u003e1\u003c/span\u003e\u003cspan class=\"p\"\u003e);\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e        \u003c/span\u003e\u003cspan class=\"n\"\u003eSystem\u003c/span\u003e\u003cspan class=\"p\"\u003e.\u003c/span\u003e\u003cspan class=\"na\"\u003eout\u003c/span\u003e\u003cspan class=\"p\"\u003e.\u003c/span\u003e\u003cspan class=\"na\"\u003eprintln\u003c/span\u003e\u003cspan class=\"p\"\u003e(\u003c/span\u003e\u003cspan class=\"n\"\u003ebook\u003c/span\u003e\u003cspan class=\"p\"\u003e);\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e    \u003c/span\u003e\u003cspan class=\"p\"\u003e}\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e\u003c/span\u003e\u003cspan class=\"p\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e",
        "language": "en"
    },
    {
        "title" : "Mastering Maven: Advanced Techniques and Best Practices",
        "date_published" : "2023-02-12T17:45:04+08:00",
        "date_modified" : "2023-02-12T17:45:04+08:00",
        "id" : "https://jerrysmd.github.io/20230212_mastering-maven/",
        "url" : "https://jerrysmd.github.io/20230212_mastering-maven/",
        "summary": "This article delves into advanced techniques and best practices for using Maven, a popular build automation tool for Java projects. Topics covered include module development and design, dependency management, aggregation and inheritance, property management, and multi-environment configuration and deployment. Whether you\u0026rsquo;re a seasoned Maven user or just getting started, this article will provide valuable insights to streamline your development process and improve your project\u0026rsquo;s overall quality.\n",
        "content_html" : "\u003cp\u003eThis article delves into advanced techniques and best practices for using Maven, a popular build automation tool for Java projects. Topics covered include module development and design, dependency management, aggregation and inheritance, property management, and multi-environment configuration and deployment. Whether you\u0026rsquo;re a seasoned Maven user or just getting started, this article will provide valuable insights to streamline your development process and improve your project\u0026rsquo;s overall quality.\u003c/p\u003e\n\u003ch2 id=\"分模块开发与设计\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%88%86%e6%a8%a1%e5%9d%97%e5%bc%80%e5%8f%91%e4%b8%8e%e8%ae%be%e8%ae%a1\" class=\"header-mark\"\u003e\u003c/a\u003e分模块开发与设计\u003c/h2\u003e\u003ch3 id=\"分模块开发意义\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%88%86%e6%a8%a1%e5%9d%97%e5%bc%80%e5%8f%91%e6%84%8f%e4%b9%89\" class=\"header-mark\"\u003e\u003c/a\u003e分模块开发意义\u003c/h3\u003e\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20230212_mastering-maven/image-20230612175146310.png' srcset=\"/20230212_mastering-maven/image-20230612175146310_hu_804273dc82c0f5c6.webp 800w, /20230212_mastering-maven/image-20230612175146310_hu_70321f1632b9f339.webp 1200w, /20230212_mastering-maven/image-20230612175146310_hu_8cf1a7cecb0f539a.webp 1600w\"  alt=\"image-20230612175146310\" height=\"907\" width=\"1779\"\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20230212_mastering-maven/image-20230612175345645.png' srcset=\"/20230212_mastering-maven/image-20230612175345645_hu_d5e46ade6e6fe11e.webp 800w, /20230212_mastering-maven/image-20230612175345645_hu_5d9d15d3b648032.webp 1200w, /20230212_mastering-maven/image-20230612175345645_hu_42f1a11ea8a65c92.webp 1600w\"  alt=\"image-20230612175345645\" height=\"853\" width=\"1710\"\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20230212_mastering-maven/image-20230612175744597.png' srcset=\"/20230212_mastering-maven/image-20230612175744597_hu_3d20e67ef9c0adee.webp 800w, /20230212_mastering-maven/image-20230612175744597_hu_30b1584bbab52c56.webp 1200w, /20230212_mastering-maven/image-20230612175744597_hu_175e7a7ade963635.webp 1600w\"  alt=\"image-20230612175744597\" height=\"910\" width=\"1633\"\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch3 id=\"分模块开发与设计-1\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%88%86%e6%a8%a1%e5%9d%97%e5%bc%80%e5%8f%91%e4%b8%8e%e8%ae%be%e8%ae%a1-1\" class=\"header-mark\"\u003e\u003c/a\u003e分模块开发与设计\u003c/h3\u003e\u003ch4 id=\"目前-ssm-目录\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e7%9b%ae%e5%89%8d-ssm-%e7%9b%ae%e5%bd%95\" class=\"header-mark\"\u003e\u003c/a\u003e目前 SSM 目录\u003c/h4\u003e\u003cul\u003e\n\u003cli\u003e📂src.main.java.com.jerry\n\u003cul\u003e\n\u003cli\u003e📂config\n\u003cul\u003e\n\u003cli\u003e☕JdbcConfig\u003c/li\u003e\n\u003cli\u003e☕MyBatisConfig\u003c/li\u003e\n\u003cli\u003e☕ServletConfig\u003c/li\u003e\n\u003cli\u003e☕SpringConfig\u003c/li\u003e\n\u003cli\u003e☕SpringMvcConfig\u003c/li\u003e\n\u003cli\u003e☕SpringMvcSupport\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e📂controller\n\u003cul\u003e\n\u003cli\u003e☕BookController\u003c/li\u003e\n\u003cli\u003e☕Code\u003c/li\u003e\n\u003cli\u003e☕ProjectExceptionAdvice\u003c/li\u003e\n\u003cli\u003e☕Result\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e📂dao\n\u003cul\u003e\n\u003cli\u003e📂impl\u003c/li\u003e\n\u003cli\u003e☕BookDao\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e📂domain\n\u003cul\u003e\n\u003cli\u003e☕Book\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e📂exception\u003c/li\u003e\n\u003cli\u003e📂service\n\u003cul\u003e\n\u003cli\u003e📂impl\u003c/li\u003e\n\u003cli\u003e☕BookService\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch4 id=\"分模块需求\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%88%86%e6%a8%a1%e5%9d%97%e9%9c%80%e6%b1%82\" class=\"header-mark\"\u003e\u003c/a\u003e分模块需求\u003c/h4\u003e\u003cp\u003e业务扩张，domain 需要拆分成新的 Module\u003c/p\u003e\n\u003cp\u003e(所有的功能都可以拆分成新 Module，这里以 domain 为例)\u003c/p\u003e\n\u003ch4 id=\"分模块步骤\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%88%86%e6%a8%a1%e5%9d%97%e6%ad%a5%e9%aa%a4\" class=\"header-mark\"\u003e\u003c/a\u003e分模块步骤\u003c/h4\u003e\u003col\u003e\n\u003cli\u003e\n\u003cp\u003e创建新的 Pojo Module, 并将 \u003cstrong\u003eSSM Module\u003c/strong\u003e 的 domain 文件迁移到新 \u003cstrong\u003ePojo Module\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003ePojo(Plain Old Java Object): 轻量级的 Java Bean，通常只包含私有属性、getter 和 setter 方法以及无参构造函数\u003c/li\u003e\n\u003cli\u003e在 SSM 架构中，通常将 POJO 用作数据传输对象（DTO）或持久化对象（PO）\u003c/li\u003e\n\u003cli\u003e与 POJO 相对应的是领域对象（domain object），也称为实体对象（entity），它代表应用程序的业务实体，通常包含业务逻辑和状态信息\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e此时 SSM 项目在所有用到 domain 对象的地方都报错，如：\u003ccode\u003epublic boolean save(Book book)\u003c/code\u003e, 需要在 SSM Module 的 pom 文件中引入 Pojo Module\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003e在 SSM pom 文件中引入 Pojo 作为依赖\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    \n    tw-flex \n    tw-flex-row\n    tw-flex-1 \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        code-block-button\n        tw-mx-2 \n        tw-flex\n        tw-flex-row\n        tw-flex-1\"\n      aria-hidden=\"true\"\u003e\n          \u003cdiv class=\"group-[.is-open]:tw-rotate-90 tw-transition-[transform] tw-duration-500 tw-ease-in-out print:!tw-hidden tw-w-min tw-h-min tw-my-1 tw-mx-1\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u003c/div\u003e\n          \u003cp class=\"tw-select-none !tw-my-1\"\u003exml\u003c/p\u003e\n      \u003c/button\u003e\n\n   \u003cdiv class=\"tw-flex\"\u003e\n      \u003cbutton \n        class=\"\n          line-number-button\n          tw-mx-2 \n          tw-hidden \n          group-[.is-open]:tw-block \n          group-[.show-line-numbers]:tw-text-fgColor-link \n          print:!tw-hidden\" \n        title=\"Toggle line numbers\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M61.77 401l17.5-20.15a19.92 19.92 0 0 0 5.07-14.19v-3.31C84.34 356 80.5 352 73 352H16a8 8 0 0 0-8 8v16a8 8 0 0 0 8 8h22.83a157.41 157.41 0 0 0-11 12.31l-5.61 7c-4 5.07-5.25 10.13-2.8 14.88l1.05 1.93c3 5.76 6.29 7.88 12.25 7.88h4.73c10.33 0 15.94 2.44 15.94 9.09 0 4.72-4.2 8.22-14.36 8.22a41.54 41.54 0 0 1-15.47-3.12c-6.49-3.88-11.74-3.5-15.6 3.12l-5.59 9.31c-3.72 6.13-3.19 11.72 2.63 15.94 7.71 4.69 20.38 9.44 37 9.44 34.16 0 48.5-22.75 48.5-44.12-.03-14.38-9.12-29.76-28.73-34.88zM496 224H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16v-32a16 16 0 0 0