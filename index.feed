w\"\u003e \u003c/span\u003e\u003cspan class=\"n\"\u003ethreadPoolExecutor\u003c/span\u003e\u003cspan class=\"p\"\u003e;\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e    \u003c/span\u003e\u003cspan class=\"p\"\u003e}\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e\u003c/span\u003e\u003cspan class=\"p\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003ch3 id=\"主流数据丢失\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e4%b8%bb%e6%b5%81%e6%95%b0%e6%8d%ae%e4%b8%a2%e5%a4%b1\" class=\"header-mark\"\u003e\u003c/a\u003e主流数据丢失\u003c/h3\u003e\u003cp\u003e使用 intervalJoin 来管理流的状态时间，保证当支流数据到达时主流数据还保存在状态中。\u003c/p\u003e\n\u003ch3 id=\"业务数据写入dwm-1\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e4%b8%9a%e5%8a%a1%e6%95%b0%e6%8d%ae%e5%86%99%e5%85%a5dwm-1\" class=\"header-mark\"\u003e\u003c/a\u003e业务数据写入DWM\u003c/h3\u003e\u003ch4 id=\"代码实现---支付宽表\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e4%bb%a3%e7%a0%81%e5%ae%9e%e7%8e%b0---%e6%94%af%e4%bb%98%e5%ae%bd%e8%a1%a8\" class=\"header-mark\"\u003e\u003c/a\u003e代码实现 - 支付宽表\u003c/h4\u003e\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    \n    tw-flex \n    tw-flex-row\n    tw-flex-1 \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        code-block-button\n        tw-mx-2 \n        tw-flex\n        tw-flex-row\n        tw-flex-1\"\n      aria-hidden=\"true\"\u003e\n          \u003cdiv class=\"group-[.is-open]:tw-rotate-90 tw-transition-[transform] tw-duration-500 tw-ease-in-out print:!tw-hidden tw-w-min tw-h-min tw-my-1 tw-mx-1\"\u003e\u003csvg class=\"ico