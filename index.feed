icense - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-1\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"c\"\u003e\u0026lt;!--SSM pom 依赖--\u0026gt;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nt\"\u003e\u0026lt;dependency\u0026gt;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e    \u003cspan class=\"nt\"\u003e\u0026lt;groupId\u0026gt;\u003c/span\u003ecom.jerry\u003cspan class=\"nt\"\u003e\u0026lt;/groupId\u0026gt;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e    \u003cspan class=\"nt\"\u003e\u0026lt;artifactId\u0026gt;\u003c/span\u003epojo_module\u003cspan class=\"nt\"\u003e\u0026lt;/artifactId\u0026gt;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e    \u003cspan class=\"nt\"\u003e\u0026lt;version\u0026gt;\u003c/span\u003e1.0-SNAPSHOT\u003cspan class=\"nt\"\u003e\u0026lt;/version\u0026gt;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nt\"\u003e\u0026lt;/dependency\u0026gt;\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003c/ol\u003e\n\u003ch2 id=\"依赖管理\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e4%be%9d%e8%b5%96%e7%ae%a1%e7%90%86\" class=\"header-mark\"\u003e\u003c/a\u003e依赖管理\u003c/h2\u003e\u003ch3 id=\"依赖传递\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e4%be%9d%e8%b5%96%e4%bc%a0%e9%80%92\" class=\"header-mark\"\u003e\u003c/a\u003e依赖传递\u003c/h3\u003e\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20230212_mastering-maven/image-20230613164639347.png' srcset=\"/20230212_mastering-maven/image-20230613164639347_hu_928cff76758b7d06.webp 800w, /20230212_mastering-maven/image-20230613164639347_hu_61434834a1320e62.webp 1200w, /20230212_mastering-maven/image-20230613164639347_hu_1d1fb1f1573cb4c2.webp 1600w\"  alt=\"image-20230613164639347\" height=\"803\" width=\"1464\"\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20230212_mastering-maven/image-20230613163454510.png' srcset=\"/20230212_mastering-maven/image-20230613163454510_hu_70a6f32aec8324b9.webp 800w, /20230212_mastering-maven/image-20230613163454510_hu_5b4fc77a52e6aaf5.webp 1200w, /20230212_mastering-maven/image-20230613163454510_hu_7ba257d7bb20c13b.webp 1600w\"  alt=\"image-20230613163454510\" height=\"627\" width=\"510\"\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e目前项目中，在 SSM，Pojo 和 Dao 三个Module POM 文件中，SSM 依赖了 Pojo 和 Dao\u003c/li\u003e\n\u003cli\u003e而 Dao 本身也依赖了 Pojo\u003c/li\u003e\n\u003cli\u003e根据依赖传递，SSM POM 文件中可以不写 Pojo 依赖\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=