/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e        \u003c/span\u003e\u003cspan class=\"n\"\u003eSout\u003c/span\u003e\u003cspan class=\"p\"\u003e(\u003c/span\u003e\u003cspan class=\"s\"\u003e\u0026#34;postHandle\u0026#34;\u003c/span\u003e\u003cspan class=\"p\"\u003e);\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e    \u003c/span\u003e\u003cspan class=\"p\"\u003e}\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e    \n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e    \u003c/span\u003e\u003cspan class=\"nd\"\u003e@Override\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e    \u003c/span\u003e\u003cspan class=\"kd\"\u003epublic\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"kt\"\u003evoid\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"nf\"\u003eafterHandle\u003c/span\u003e\u003cspan class=\"p\"\u003e(\u003c/span\u003e\u003cspan class=\"n\"\u003eHttpServletRequest\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"n\"\u003erequest\u003c/span\u003e\u003cspan class=\"p\"\u003e,\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"n\"\u003eHttpServletResponse\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"n\"\u003eresponse\u003c/span\u003e\u003cspan class=\"p\"\u003e,\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"n\"\u003eObject\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"n\"\u003ehandler\u003c/span\u003e\u003cspan class=\"p\"\u003e,\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"n\"\u003eException\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"n\"\u003eex\u003c/span\u003e\u003cspan class=\"p\"\u003e)\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"kd\"\u003ethrows\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"n\"\u003eException\u003c/span\u003e\u003cspan class=\"p\"\u003e{\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e        \u003c/span\u003e\u003cspan class=\"n\"\u003eSout\u003c/span\u003e\u003cspan class=\"p\"\u003e(\u003c/span\u003e\u003cspan class=\"s\"\u003e\u0026#34;afterHandle\u0026#34;\u003c/span\u003e\u003cspan class=\"p\"\u003e);\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e    \u003c/span\u003e\u003cspan class=\"p\"\u003e}\u003c/span\u003e\u003cspan class=\"w\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"w\"\u003e\u003c/span\u003e\u003cspan class=\"p\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20220914_springmvc-intro/image-20230612133004236.png' srcset=\"/20220914_springmvc-intro/image-20230612133004236_hu_5660a5d207a13997.webp 800w, /20220914_springmvc-intro/image-20230612133004236_hu_48d3576cf7dda87e.webp 1200w, /20220914_springmvc-intro/image-20230612133004236_hu_bc27945ce490c923.webp 1600w\"  alt=\"image-20230612133004236\" height=\"778\" width=\"1727\"\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch3 id=\"拦截器参数\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e6%8b%a6%e6%88%aa%e5%99%a8%e5%8f%82%e6%95%b0\" class=\"header-mark\"\u003e\u003c/a\u003e拦截器参数\u003c/h3\u003e\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003e前置处理\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003erequest: 请求对象\u003c/li\u003e\n\u003cli\u003eresponse: 响应对象\u003c/li\u003e\n\u003cli\u003ehandler: 被调用的处理器对象，本质上是一个方法对象，对反射技术中的 Method 对象进行了再包\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e后置处理\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003emodelAndView: 如果处理器执行完成具有返回结果，可以读取到对应数据与页面信息，并进行调整。(现有开发模式不用使用)\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e完成后处理\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eex: 处理过程中出现的异常对象。(Mvc 的异常处理机制可以完美替代这个操作)\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3 id=\"拦截器链配置\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e6%8b%a6%e6%88%aa%e5%99%a8%e9%93%be%e9%85%8d%e7%bd%ae\" class=\"header-mark\"\u003e\u003c/a\u003e拦截器链配置\u003c/h3\u003e\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20220914_springmvc-intro/image-20230612134410284.png' srcset=\"/20220914_springmvc-intro/image-20230612134410284_hu_165ae57f10ccd756.webp 800w, /20220914_springmvc-intro/image-20230612134410284_hu_90b989473c6df056.webp 1200w, /20220914_springmvc-intro/image-20230612134410284_hu_a151144898735684.webp 1600w\"  alt=\"image-20230612134410284\" height=\"836\" width=\"1539\"\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e",
        "language": "en"
    },
    {
        "title" : "Spring Framework Introduction",
        "date_published" : "2022-08-05T11:38:27+08:00",
        "date_modified" : "2022-08-05T11:38:27+08:00",
        "id" : "https://jerrysmd.github.io/20220805_spring-intro/",
        "url" : "https://jerrysmd.github.io/20220805_spring-intro/",
        "summary": "Spring makes programming Java quicker, easier, and safer. Spring’s focus on speed, simplicity, and productivity has made it the world\u0026rsquo;s most popular Java framework. Spring works on microservices, reactive, cloud, web apps, serverless, event driven, and batch services.\n",
        "content_html" : "\u003cp\u003eSpring makes programming Java quicker, easier, and safer. Spring’s focus on speed, simplicity, and productivity has made it the world\u0026rsquo;s most popular Java framework. Spring works on microservices, reactive, cloud, web apps, serverless, event driven, and batch services.\u003c/p\u003e\n\u003ch2 id=\"framework\" class=\"headerLink\"\u003e\n    \u003ca href=\"#framework\" class=\"header-mark\"\u003e\u003c/a\u003eFramework\u003c/h2\u003e\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20220805_spring-intro/spring-overview.png' srcset=\"/20220805_spring-intro/spring-overview_hu_f97c829bb8008713.webp 800w, /20220805_spring-intro/spring-overview_hu_243e3316ced0b47.webp 1200w, /20220805_spring-intro/spring-overview_hu_c8d9f74974bf4083.webp 1600w\"  alt=\"spring-overview\" height=\"540\" width=\"720\"\u003e\u003cfigcaption class=\"image-caption\"\u003espring-overview\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cblockquote\u003e\n  \u003cp\u003e上层依赖于下层\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cdiv class=\"table-wrapper\"\u003e\n  \u003ctable\u003e\n    \u003cthead\u003e\n        \u003ctr\u003e\n            \u003cth style=\"text-align: \"\u003eCore Container\u003c/th\u003e\n            \u003cth style=\"text-align: \"\u003e核心容器，管理对象\u003c/th\u003e\n        \u003c/tr\u003e\n    \u003c/thead\u003e\n    \u003ctbody\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: \"\u003eAOP\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e面向切面编程\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: \"\u003eAspects\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003eAOP 思想实现\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: \"\u003eData Access / Integration\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e数据访问 / 集成\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: \"\u003e\u003cstrong\u003eTransactions\u003c/strong\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: \"\u003e\u003cstrong\u003e事务\u003c/strong\u003e\u003c/td\u003e\n        \u003c/tr\u003e\n    \u003c/tbody\u003e\n  \u003c/table\u003e\n\u003c/div\u003e\n\u003ch2 id=\"核心容器\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e6%a0%b8%e5%bf%83%e5%ae%b9%e5%99%a8\" class=\"header-mark\"\u003e\u003c/a\u003e核心容器\u003c/h2\u003e\u003ch3 id=\"ioc--di\" class=\"headerLink\"\u003e\n    \u003ca href=\"#ioc--di\" class=\"header-mark\"\u003e\u003c/a\u003eIoC \u0026amp; DI\u003c/h3\u003e\u003cblockquote\u003e\n  \u003cp\u003eIoC (Inversion of Control) 控制反转\u003c/p\u003e\n\u003cp\u003eDI (Dependency Injection) 依赖注入\u003c/p\u003e\n\u003c/blockquote\u003e\u003cul\u003e\n\u003cli\u003e场景：\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    \n    tw-flex \n    tw-flex-row\n    tw-flex-1 \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        code-block-button\n        tw-mx-2 \n        tw-flex\n        tw-flex-row\n        tw-flex-1\"\n      aria-hidden=\"true\"\u003e\n          \u003cdiv class=\"group-[.is-open]:tw-rotate-90 tw-transition-[transform] tw-duration-500 tw-ease-in-out print:!tw-hidden tw-w-min tw-h-min tw-my-1 tw-mx-1\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u003c/div\u003e\n          \u003cp class=\"tw-select-none !tw-my-1\"\u003ejava\u003c/p\u003e\n      \u003c/button\u003e\n\n   \u003cdiv class=\"tw-flex\"\u003e\n      \u003cbutton \n        class=\"\n          line-number-button\n          tw-mx-2 \n          tw-hidden \n          group-[.is-open]:tw-block \n          group-[.show-line-numbers]:tw-text-fgColor-link \n          print:!tw-hidden\" \n        title=\"Toggle line numbers\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M61.77 401l17.5-20.15a19.92 19.92 0 0 0 5.07-14.19v-3.31C84.34 356 80.5 352 73 352H16a8 8 0 0 0-8 8v16a8 8 0 0 0 8 8h22.83a157.41 157.41 0 0 0-11 12.31l-5.61 7c-4 5.07-5.25 10.13-2.8 14.88l1.05 1.93c3 5.76 6.29 7.88 12.25 7.88h4.73c10.33 0 15.94 2.44 15.94 9.09 0 4.72-4.2 8.22-14.36 8.22a41.54 41.54 0 0 1-15.47-3.12c-6.49-3.88-11.74-3.5-15.6 3.12l-5.59 9.31c-3.72 6.13-3.19 11.72 2.63 15.94 7.71 4.69 20.38 9.44 37 9.44 34.16 0 48.5-22.75 48.5-44.12-.03-14.38-9.12-29.76-28.73-34.88zM496 224H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16v-32a16 16 0 0 0-16-16zm0-160H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16V80a16 16 0 0 0-16-16zm0 320H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16v-32a16 16 0 0 0-16-16zM16 160h64a8 8 0 0 0 8-8v-16a8 8 0 0 0-8-8H64V40a8 8 0 0 0-8-8H32a8 8 0 0 0-7.14 4.42l-8 16A8 8 0 0 0 24 64h8v64H16a8 8 0 0 0-8 8v16a8 8 0 0 0 8 8zm-3.91 160H80a8 8 0 0 0 8-8v-16a8 8 0 0 0-8-8H41.32c3.29-10.29 48.34-18.68 48.34-56.44 0-29.06-25-39.56-44.47-39.56-21.36 0-33.8 10-40.46 18.75-4.37 5.59-3 10.84 2.8 15.37l8.58 6.88c5.61 4.56 11 2.47 16.12-2.44a13.44 13.44 0 0