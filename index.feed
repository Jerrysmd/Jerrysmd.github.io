;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e    \u003cspan class=\"nt\"\u003e\u0026lt;configration\u0026gt;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e        \u003cspan class=\"nt\"\u003e\u0026lt;failOnMissingWebXml\u0026gt;\u003c/span\u003efalse\u003cspan class=\"nt\"\u003e\u0026lt;/failOnMissingWebXml\u0026gt;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e    \u003cspan class=\"nt\"\u003e\u0026lt;/configration\u0026gt;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nt\"\u003e\u0026lt;/plugin\u0026gt;\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3 id=\"其他属性\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%85%b6%e4%bb%96%e5%b1%9e%e6%80%a7\" class=\"header-mark\"\u003e\u003c/a\u003e其他属性\u003c/h3\u003e\n\u003cdiv class=\"table-wrapper\"\u003e\n  \u003ctable\u003e\n    \u003cthead\u003e\n        \u003ctr\u003e\n            \u003cth style=\"text-align: center\"\u003e属性分类\u003c/th\u003e\n            \u003cth style=\"text-align: center\"\u003e引用格式\u003c/th\u003e\n            \u003cth style=\"text-align: center\"\u003e示例\u003c/th\u003e\n        \u003c/tr\u003e\n    \u003c/thead\u003e\n    \u003ctbody\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: center\"\u003e自定义属性\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e${自定义属性名}\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e${spring.version}\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: center\"\u003e内置属性\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e${内置属性名}\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e${basedir} ${version}\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: center\"\u003eSetting 属性\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e${setting.属性名}\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e${settings.localRepository}\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: center\"\u003eJava 系统属性\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e${系统属性分类.系统属性名}\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e${user.home}\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: center\"\u003e环境变量属性\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e${evn.环境变量属性名}\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e${env.JAVA_HOME}\u003c/td\u003e\n        \u003c/tr\u003e\n    \u003c/tbody\u003e\n  \u003c/table\u003e\n\u003c/div\u003e\n\u003ch2 id=\"版本管理\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e7%89%88%e6%9c%ac%e7%ae%a1%e7%90%86\" class=\"header-mark\"\u003e\u003c/a\u003e版本管理\u003c/h2\u003e\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20230212_mastering-maven/image-20230616111425539.png' srcset=\"/20230212_mastering-maven/image-20230616111425539_hu_a9876cd5c208cf8e.webp 800w, /20230212_mastering-maven/image-20230616111425539_hu_31eddd8a985df806.webp 1200w, /20230212_mastering-maven/image-20230616111425539_hu_191dd89caed3aad7.webp 1600w\"  alt=\"image-20230616111425539\" height=\"842\" width=\"1626\"\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003cimg  loading=\"lazy\" src='/20230212_mastering-maven/image-20230616111547100.png' srcset=\"/20230212_mastering-maven/image-20230616111547100_hu_120aa3597bdcf9