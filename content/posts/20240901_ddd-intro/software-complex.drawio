        <mxCell id="TjJ7RFLJj6_N5epalvzf-10" value="&lt;ul&gt;&lt;li&gt;&lt;b&gt;Perspective&lt;/b&gt;: &lt;br&gt;Abstract dependencies, focus on viewpoints&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;b&gt;Code&lt;/b&gt;:&amp;nbsp;&lt;br&gt;&lt;/span&gt;Decouple code from the real world details&lt;/li&gt;&lt;/ul&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;verticalAlign=middle;overflow=hidden;" parent="1" vertex="1">
